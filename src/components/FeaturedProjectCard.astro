---
import { type CollectionEntry } from 'astro:content';
import { projectTagsToBadges } from '../data/project-tags';
import ProjectMeta from './ProjectMeta.astro';

type Props = { project: CollectionEntry<'projects'>; class?: string };

const { project, class: className } = Astro.props;
const { title, description, tags, technologies } = project.data;
const tagBadges = projectTagsToBadges(tags);
---

<a
    class:list={[
        'group block border border-main/15 p-5 sm:p-6 transition-all duration-300 ease-out hover:border-accent/30 focus-visible:outline-offset-4',
        className
    ]}
    href={`/projects/${project.slug}/`}
>
    <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1.5">
        <h3 class="font-sans text-lg sm:text-xl font-medium text-main leading-snug tracking-tight group-hover:opacity-75 transition-opacity duration-200">
            {title}
        </h3>
        {
            tagBadges.length > 0 && (
                <div class="flex flex-wrap items-center gap-1.5">
                    {tagBadges.map((t) => (
                        <span class:list={['font-mono text-xs px-1.5 py-0.5 leading-tight', t.classes]}>{t.label}</span>
                    ))}
                </div>
            )
        }
    </div>
    {description && <p class="mt-2 text-sm text-muted leading-relaxed">{description}</p>}
    {technologies.length > 0 && <ProjectMeta technologies={technologies} class="mt-3" />}
</a>
